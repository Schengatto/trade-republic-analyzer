{
  "name": "trade-republic-analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "Client-side analyzer for Trade Republic transaction exports. Your data never leaves your browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run check:bundle",
    "preview": "vite preview",
    "check:bundle": "node scripts/check-bundle.mjs",
    "capture:demo": "npm run build && node scripts/capture-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/papaparse": "^5.3.14",
    "eslint": "^9.9.0",
    "gifenc": "^1.0.3",
    "jsdom": "^30.0.1",
    "pngjs": "^7.0.0",
    "semver": "^7.7.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
